# Crea primero la base geopol y el usuario geopol_app en PostgreSQL.
# Reemplaza TU_CLAVE por la contraseña de ese usuario.
GEOPOL_DATABASE_URL=postgresql+psycopg://geopol_app:TU_CLAVE@127.0.0.1:5432/geopol
GEOPOL_STORAGE_PATH=../data/storage
GEOPOL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcional: contraseña web inicial (mínimo 12 caracteres).
# Si la omites, el backend la solicita la primera vez.
# Solo se utiliza si todavía no existen usuarios; no cambia cuentas existentes.
# GEOPOL_BOOTSTRAP_PASSWORD=ELIGE_UNA_CONTRASENA_WEB_PROPIA
